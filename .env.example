# ==============================================================================
# ARZON MARKET — HAQIQIY SMS VA TELEGRAM SOZLAMALARI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HAQIQIY SMS XIZMATI: ESKIZ.UZ (O'zbekiston rasmiy SMS shlyuzi)
# ------------------------------------------------------------------------------
# Eskiz.uz saytidan ro'yxatdan o'ting va login/parolingizni yozing:
ESKIZ_EMAIL="sizning_eskiz_emailingiz@mail.com"
ESKIZ_PASSWORD="sizning_eskiz_parolingiz"
# Yoki doimiy token bo'lsa:
# ESKIZ_TOKEN=""

# ------------------------------------------------------------------------------
# 2. XALQARO SMS (IXTIYORIY): TWILIO SMS
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT VA AI SOZLAMALARI
# ------------------------------------------------------------------------------
# @BotFather dan olingan bot tokeni:
TELEGRAM_BOT_TOKEN="sizning_telegram_bot_tokeningiz"

# Google Gemini AI kaliti (cheksiz aqlli javoblar uchun):
GEMINI_API_KEY=""
